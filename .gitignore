# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# SvelteKit `frontend/src/lib/` is source code, not a Python venv `lib/`
!frontend/src/lib/
!frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Pipenv ---
.venv/
Pipfile.lock.bak

# --- Node / pnpm / SvelteKit ---
node_modules/
.svelte-kit/
.turbo/
.vercel/
.netlify/
.next/
out/
*.tsbuildinfo

# --- Vite / build outputs ---
.pnp.*
.yarn/
 
# --- Data and runtime artefacts (must NOT be committed) ---
data/uploads/*
!data/uploads/.gitkeep
# Runtime artefacts: never committed.
data/experiments/
data/audio/
# Frontend Chroma store (mutable, runtime); experiment stores under data/ablation_*/vector_db ARE committed
data/vector_db/
# CatBoost runtime directory
catboost_info/
# PANNs CNN14 checkpoint (downloaded by sound_classifier on first use)
panns_data/

# --- Local environment / secrets ---
.env
.env.local
.env.*.local
*.pem
credentials.json

# --- Editor / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
# Papermill per-job stdout captures (untracked runtime artifacts)
*.out

# --- Test / coverage ---
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/*
!coverage/coverage.json
frontend/coverage/
*.cover
:Zone.Identifier
*Zone.Identifier
*.sfk